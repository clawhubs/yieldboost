# YieldBoost AI mainnet cutover template
# Copy values into `.env.local` or your deployment platform when you are ready.

# Public app + wallet network metadata
NEXT_PUBLIC_APP_URL=https://your-production-domain.example
NEXT_PUBLIC_0G_MAINNET_CHAIN_ID=16661
NEXT_PUBLIC_0G_MAINNET_CHAIN_NAME=0G Mainnet
NEXT_PUBLIC_0G_MAINNET_EXPLORER_BASE_URL=https://chainscan.0g.ai
NEXT_PUBLIC_0G_MAINNET_RPC=https://evmrpc.0g.ai
NEXT_PUBLIC_0G_MAINNET_STORAGE=<mainnet_storage_endpoint>

# Default active server network
ZG_NETWORK_KEY=mainnet

# Mainnet proof path
ZG_MAINNET_RPC_URL=https://evmrpc.0g.ai
ZG_MAINNET_STORAGE_URL=<mainnet_storage_endpoint>
ZG_MAINNET_PRIVATE_KEY=<mainnet_storage_signer_private_key>
ZG_MAINNET_PROOF_REGISTRY_ADDRESS=<mainnet_proof_registry_address>

# Mainnet 0G Compute / TEE path
ZG_MAINNET_COMPUTE_PROVIDER_ADDRESS=<mainnet_compute_provider_address>
ZG_MAINNET_LEDGER_PRIVATE_KEY=<mainnet_compute_or_contract_signer_private_key>

# Mainnet Agent NFT contract
YIELD_STRATEGY_INFT_MAINNET_ADDRESS=<mainnet_yield_strategy_inft_address>
YIELD_STRATEGY_ATTESTATION_ORACLE_MAINNET_ADDRESS=<mainnet_attestation_oracle_address>
YIELD_STRATEGY_MARKETPLACE_MAINNET_ADDRESS=<mainnet_strategy_marketplace_address>

# Mainnet integrity stack contracts
GLOBAL_BLACKLIST_REGISTRY_MAINNET_ADDRESS=<mainnet_global_blacklist_registry_address>
VALIDATION_REGISTRY_MAINNET_ADDRESS=<mainnet_validation_registry_address>

# Optional Alibaba semantic cache / embedding reuse
ALIBABA_API_KEY=<dashscope_api_key>
ALIBABA_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
ALIBABA_MODEL=qwen3.6-plus-2026-04-02
ALIBABA_EMBEDDING_MODEL=text-embedding-v4
ALIBABA_EMBEDDING_DIMENSION=512
STRATEGY_METADATA_ENCRYPTION_KEY=<64_hex_or_32_byte_base64_secret>

# Optional shared fallbacks if you prefer one signer/provider across networks
# ZG_COMPUTE_PROVIDER_ADDRESS=<shared_compute_provider_address>
# ZG_LEDGER_PRIVATE_KEY=<shared_ledger_private_key>
# ZG_PRIVATE_KEY=<shared_storage_or_contract_signer_private_key>

# Optional persistence / rate limit infrastructure
KV_REST_API_URL=<vercel_kv_url>
KV_REST_API_TOKEN=<vercel_kv_token>
UPSTASH_REDIS_REST_URL=<upstash_redis_rest_url>
UPSTASH_REDIS_REST_TOKEN=<upstash_redis_rest_token>
